APP_ENV=development
APP_NAME=Research Atlas API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
OPENALEX_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
EXTRACTION_MAX_OUTPUT_TOKENS=2500
EXTRACTION_CONCURRENCY=3
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
CROSS_ENCODER_DEVICE=
CROSS_ENCODER_BATCH_SIZE=16
CROSS_ENCODER_CANDIDATE_LIMIT=50
RANKING_RESULT_LIMIT=25
INSTALL_ML=false
DATABASE_URL=postgresql+asyncpg://research_atlas:research_atlas@database:5432/research_atlas
POSTGRES_DB=research_atlas
POSTGRES_USER=research_atlas
POSTGRES_PASSWORD=research_atlas
